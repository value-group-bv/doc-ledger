<div {{ attributes }}>

{% if savedDocumentId %}
{# ── Success state ──────────────────────────────────────────────────────────── #}
<twig:Alert variant="success" class="mb-6">
    <twig:ux:icon name="material-symbols:check-circle-outline" class="size-4" />
    <twig:Alert:Title>Entry registered</twig:Alert:Title>
    <twig:Alert:Description>
        Document ID <code class="font-mono font-semibold">{{ savedDocumentId }}</code> has been saved to the ledger.
    </twig:Alert:Description>
</twig:Alert>

<button type="button" data-action="live#action" data-live-action-param="resetConfirmation"
    class="inline-flex items-center gap-1.5 bg-primary hover:bg-primary/90 px-4 rounded-md h-9 font-medium text-primary-foreground text-sm transition-colors">
    <twig:ux:icon name="material-symbols:add" class="size-4" />
    Register another
</button>

{% else %}
{# ── Wizard form ─────────────────────────────────────────────────────────────── #}

{# Fetched up front: inside <twig:Select> blocks, `this` is the Select component #}
{% set subsidiaries = this.subsidiaries %}
{% set mainCategories = this.mainCategories %}
{% set docTypes = this.docTypes %}
{% set subCategories = this.subCategories %}

<div class="gap-8 grid grid-cols-1 lg:grid-cols-3">

    {# Left: form fields #}
    <div class="lg:col-span-2 rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="p-6 space-y-5">

        {# Row 1: Subsidiary + Main category #}
        <div class="gap-4 grid grid-cols-2">
            <div class="gap-2 grid">
                <label class="font-medium text-sm">Subsidiary</label>
                <twig:Select data-model="subsidiaryId" data-action="change->live#action">
                    <option value="0">select</option>
                    {% for s in subsidiaries %}
                    <option value="{{ s.id }}" {% if subsidiaryId == s.id %}selected{% endif %}>{{ s.code }} - {{ s.description }}</option>
                    {% endfor %}
                </twig:Select>
            </div>
            <div class="gap-2 grid">
                <label class="font-medium text-sm">Main category</label>
                <twig:Select data-model="mainCategoryId" data-action="change->live#action">
                    <option value="0">select</option>
                    {% for mc in mainCategories %}
                    <option value="{{ mc.id }}" {% if mainCategoryId == mc.id %}selected{% endif %}>{{ mc.code }} - {{ mc.description }}</option>
                    {% endfor %}
                </twig:Select>
            </div>
        </div>

        {# Row 2: Doc type #}
        <div class="gap-2 grid">
            <label class="font-medium text-sm">Document type</label>
            <twig:Select data-model="docTypeId" data-action="change->live#action">
                <option value="0">select</option>
                {% for dt in docTypes %}
                <option value="{{ dt.id }}" {% if docTypeId == dt.id %}selected{% endif %}>{{ dt.code }} - {{ dt.description }}</option>
                {% endfor %}
            </twig:Select>
        </div>

        {# Row 4: Sub category — shown once doc type is selected #}
        {% if docTypeId %}
        <div class="gap-2 grid">
            <label class="font-medium text-sm">Sub category</label>
            <twig:Select data-model="subCategoryId" data-action="change->live#action">
                <option value="0">select</option>
                {% for sc in subCategories %}
                <option value="{{ sc.id }}" {% if subCategoryId == sc.id %}selected{% endif %}>{{ sc.formattedCode }} - {{ sc.description }}</option>
                {% endfor %}
            </twig:Select>
        </div>
        {% endif %}

        {# Row 5: Doc number — shown once sub category is selected #}
        {% if subCategoryId %}
        <div class="gap-2 grid">
            <label class="font-medium text-sm">Document number</label>

            <div class="flex gap-4 mb-2">
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="radio" data-model="docNumberMode" value="0"
                        data-action="change->live#action" class="size-4 accent-primary"
                        {% if docNumberMode == 0 %}checked{% endif %} />
                    Next available
                </label>
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input type="radio" data-model="docNumberMode" value="1"
                        data-action="change->live#action" class="size-4 accent-primary"
                        {% if docNumberMode == 1 %}checked{% endif %} />
                    Manual (000 - 999)
                </label>
            </div>

            {% if docNumberMode == 0 %}
            <p class="text-muted-foreground text-sm">Next available: <strong>{{ "%03d"|format(this.suggestedDocNumber) }}</strong></p>
            {% else %}
            {% set hasValue = manualDocNumber|default('')|length > 0 %}
            {% set isInvalid = hasValue and (manualDocNumber < '0' or manualDocNumber > '999') %}
            <twig:Input type="number" data-model="manualDocNumber"
                data-action="input->live#update:debounce(300ms)"
                value="{{ manualDocNumber }}"
                min="0" max="999" placeholder="{{ '%03d'|format(this.suggestedDocNumber) }} (next available)"
                aria-invalid="{{ isInvalid ? 'true' : 'false' }}"
                class="font-mono aria-invalid:border-destructive" />
            {% if isInvalid %}
            <p class="text-destructive text-sm">Document number must be between 0 and 999</p>
            {% endif %}
            {% endif %}
        </div>

        {# Row 5b: Alternate main categories — only for sub categories that apply to all main categories #}
        {% set alternateOptions = this.alternateMainCategoryOptions %}
        {% if alternateOptions is not empty %}
        <div class="gap-2 grid">
            <label class="font-medium text-sm">Also valid under <span class="font-normal text-muted-foreground text-xs">(optional)</span></label>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
                {% for mc in alternateOptions %}
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <twig:Checkbox data-model="alternateMainCategoryIds" value="{{ mc.id }}"
                        :checked="mc.id in alternateMainCategoryIds" />
                    {{ mc.code }} - {{ mc.description }}
                </label>
                {% endfor %}
            </div>
            <p class="text-muted-foreground text-xs">For documents that carry over to another main category, e.g. from feasibility to installation once a project is signed</p>
        </div>
        {% endif %}
        {% endif %}

        {# Row 6: Title #}
        <div class="gap-2 grid">
            <label class="font-medium text-sm">Title <span class="font-normal text-muted-foreground text-xs">(human-readable)</span></label>
            <twig:Input type="text" data-model="title"
                data-action="input->live#update:debounce(300ms)"
                oninput="this.value=this.value.replace(/[^A-Za-z0-9 ]/g,'')"
                value="{{ title }}"
                maxlength="48"
                pattern="[A-Za-z0-9 ]+"
                placeholder="e.g. System PID" />
            <p class="text-muted-foreground text-xs">Only alphanumeric characters (A-Z, a-z, 0-9) and spaces are allowed, max. 48 characters</p>
        </div>

        {# Row 7: Comments (optional) #}
        <div class="gap-2 grid">
            <label class="font-medium text-sm">Comments / search tags <span class="font-normal text-muted-foreground text-xs">(optional)</span></label>
            <twig:Textarea
                data-model="comments"
                data-action="input->live#update:debounce(300ms)"
                placeholder="Internal notes or keywords for improved searching"
                rows="3">{{ comments }}</twig:Textarea>
        </div>

        {# Duplicate error — conflicts are checked live, duplicateError covers anything caught on save #}
        {% set conflicts = this.conflictingDocumentIds %}
        {% if conflicts is not empty %}
        <twig:Alert variant="destructive">
            <twig:ux:icon name="material-symbols:error-outline" class="size-4" />
            <twig:Alert:Title>Duplicate document ID</twig:Alert:Title>
            <twig:Alert:Description>
                {% for id in conflicts %}<code class="font-mono">{{ id }}</code>{% if not loop.last %}, {% endif %}{% endfor %}
                already {{ conflicts|length == 1 ? 'exists' : 'exist' }} in the ledger. Pick another document number{% if alternateMainCategoryIds is not empty %} or untick the clashing main category{% endif %}.
            </twig:Alert:Description>
        </twig:Alert>
        {% elseif duplicateError %}
        <twig:Alert variant="destructive">
            <twig:ux:icon name="material-symbols:error-outline" class="size-4" />
            <twig:Alert:Title>Duplicate document ID</twig:Alert:Title>
            <twig:Alert:Description>{{ duplicateError }}</twig:Alert:Description>
        </twig:Alert>
        {% endif %}

        {# Submit #}
        {% set manualHasValue = manualDocNumber|default('')|length > 0 %}
        {% set docNumInvalid = docNumberMode == 1 and manualHasValue and (manualDocNumber < '0' or manualDocNumber > '999') %}
        <button type="button"
            data-action="live#action" data-live-action-param="save"
            {% if not subsidiaryId or not mainCategoryId or not docTypeId or not subCategoryId or not title or docNumInvalid or conflicts is not empty %}
            disabled
            {% endif %}
            class="inline-flex items-center gap-2 bg-primary hover:bg-primary/90 disabled:opacity-50 mt-2 px-6 rounded-md h-10 font-medium text-primary-foreground text-sm transition-colors disabled:cursor-not-allowed">
            <twig:ux:icon name="material-symbols:save-outline" class="size-4" />
            Register document ID
        </button>

    </div>
    </div>

    {# Right: live preview #}
    <div>
        {% set previewDocumentId = this.previewDocumentId %}
        {% set alternatePreviewIds = this.alternatePreviewIds %}
        <twig:Card class="top-6 sticky">
            <twig:Card:Header>
                <twig:Card:Title>Live preview</twig:Card:Title>
                <twig:Card:Description>Updates as you fill in the form</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                <div class="bg-muted p-4 rounded-lg text-center">
                    <code class="font-mono text-sm font-semibold break-all {% if previewDocumentId != '—' %}text-primary{% else %}text-muted-foreground{% endif %}">
                        {{ previewDocumentId }}
                    </code>
                </div>
                {% for alternateId in alternatePreviewIds %}
                {% if loop.first %}<p class="mt-3 mb-1 text-muted-foreground text-xs">Also valid as</p>{% endif %}
                <code class="block font-mono text-muted-foreground text-xs text-center">{{ alternateId }}</code>
                {% endfor %}
                {% if title %}
                <p class="mt-3 text-foreground text-sm">{{ title }}</p>
                {% endif %}
            </twig:Card:Content>
        </twig:Card>
    </div>

</div>

{% endif %}
</div>
