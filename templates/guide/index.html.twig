{% extends 'base.html.twig' %}

{% set page_title = 'Guide' %}
{% set page_header = true %}

{% block body %}

{# Document ID components: chip in the anatomy row, legend label, and dark-mode-aware colours #}
{% set segments = [
    {code: 'VG', legend: 'VG', color: 'bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300',
        name: 'Subsidiary', text: 'Two-letter code identifying the responsible entity within the Value Group.'},
    {code: '0', legend: '0', color: 'bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300',
        name: 'Main category', text: 'Single digit indicating the project type.'},
    {code: 'AAB', legend: 'AAB', color: 'bg-orange-100 dark:bg-orange-950 text-orange-700 dark:text-orange-300',
        name: 'Reference code', text: 'Alphabetic for studies; numeric for signed projects; fixed abbreviations for product lines.'},
    {code: 'REP', legend: 'REP', color: 'bg-blue-100 dark:bg-blue-950 text-blue-700 dark:text-blue-300',
        name: 'Document type', text: 'Short three-letter abbreviation for the type of document.'},
    {code: '000', legend: '000', color: 'bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300',
        name: 'Sub category', text: 'Three-digit code identifying the technical or functional discipline.'},
    {code: '000', legend: '000', color: 'bg-violet-100 dark:bg-violet-950 text-violet-700 dark:text-violet-300',
        name: 'Document number', text: 'Three-digit number unique within the combination of the other components.'},
    {code: '0A', legend: '0A', color: 'bg-pink-100 dark:bg-pink-950 text-pink-700 dark:text-pink-300',
        name: 'Revision', text: 'Interim drafts use an alphanumeric suffix; released versions use a numeric suffix.'},
    {code: 'Title', legend: 'Abc', color: 'bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-200',
        name: 'Title', text: 'Textual description of the document.'},
] %}

<div class="flex flex-wrap justify-between items-end gap-x-6 gap-y-3 mb-6">
    <div>
        <h1 class="font-heading font-bold text-foreground text-3xl">Guide</h1>
        <p class="mt-1 text-muted-foreground">Using the numbering system</p>
    </div>
    <nav class="flex flex-wrap gap-x-4 gap-y-1 text-muted-foreground text-sm">
        {% for id, label in {anatomy: 'Anatomy', conventions: 'Conventions', examples: 'Examples', 'dos-and-donts': "Do's and Don'ts", 'using-the-ledger': 'Using the Ledger'} %}
        <a href="#{{ id }}" class="hover:text-foreground hover:underline underline-offset-2">{{ label }}</a>
        {% endfor %}
    </nav>
</div>

<div class="gap-8 grid grid-cols-1 xl:grid-cols-2">

    {# ── Anatomy ─────────────────────────────────────────────────────── #}
    <twig:Card id="anatomy" class="xl:col-span-2 scroll-mt-4">
        <twig:Card:Header>
            <twig:Card:Title>Anatomy</twig:Card:Title>
            <twig:Card:Description>How the ID is structured</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content class="space-y-6 text-sm">

            <p>Value Ledger is the central register for document identifiers across the Value Group. Every document
                gets a unique identifier with this structure:</p>

            <div class="flex flex-wrap items-center gap-x-1 gap-y-2">
                {% for s in segments %}
                {% if not loop.first %}<span class="px-0.5 font-bold text-muted-foreground">{{ loop.last ? ' ' : '-' }}</span>{% endif %}
                <span class="{{ s.color }} px-3 py-1.5 rounded font-mono font-bold text-sm">{{ s.code }}</span>
                {% endfor %}
            </div>

            <twig:Separator />

            {# Two columns on wide screens, filled top to bottom so the order matches the ID #}
            <dl class="gap-x-8 gap-y-3 grid grid-cols-1 xl:grid-cols-2 xl:grid-rows-4 xl:grid-flow-col">
                {% for s in segments %}
                <div class="flex items-baseline gap-3">
                    <dt class="{{ s.color }} px-1.5 py-0.5 rounded w-10 font-mono font-bold text-xs text-center shrink-0">
                        {{ s.legend }}</dt>
                    <dd><strong>{{ s.name }}</strong> - {{ s.text }}</dd>
                </div>
                {% endfor %}
            </dl>

        </twig:Card:Content>
    </twig:Card>

    {# ── Conventions ─────────────────────────────────────────────────────── #}
    <twig:Card id="conventions" class="xl:col-span-2 scroll-mt-4">
        <twig:Card:Header>
            <twig:Card:Title>Conventions</twig:Card:Title>
            <twig:Card:Description>Rules and constraints for each component of the document identifier
            </twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content class="space-y-5 text-sm">

            <div class="space-y-2">
                <h3 class="font-semibold text-foreground">Document code</h3>
                <p>The document code has a fixed total length of 22 characters, including hyphens, and is always fully written in capital letters.</p>
                <div
                    class="flex gap-2 bg-amber-50 dark:bg-amber-950 px-3 py-2 border border-amber-200 dark:border-amber-800 rounded text-amber-800 dark:text-amber-200">
                    <twig:ux:icon name="material-symbols:warning-outline" class="mt-0.5 size-4 shrink-0" />
                    <div class="space-y-1.5">
                        <p>The separator between code components must be the <strong>hyphen-minus</strong>. Do not use
                            other dashes. These
                            characters look similar but are <strong>not</strong> interchangeable:</p>
                        <div class="space-y-0.5 font-mono text-xs">
                            <div class="flex items-center gap-2">
                                <span class="w-3 font-sans font-bold text-emerald-600">✓</span>
                                <code class="bg-amber-100 dark:bg-amber-900 px-1 rounded">-</code>
                                <span class="font-sans text-amber-700 dark:text-amber-300">hyphen-minus (U+002D)</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 font-sans font-bold text-red-500">✗</span>
                                <code class="bg-amber-100 dark:bg-amber-900 px-1 rounded">–</code>
                                <span class="font-sans text-amber-700 dark:text-amber-300">en dash (U+2013)</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="w-3 font-sans font-bold text-red-500">✗</span>
                                <code class="bg-amber-100 dark:bg-amber-900 px-1 rounded">—</code>
                                <span class="font-sans text-amber-700 dark:text-amber-300">em dash (U+2014)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <twig:Separator />

            <div class="space-y-2">
                <h3 class="font-semibold text-foreground">Reference codes</h3>
                <p>Reference codes are unique globally across the whole Value Group and must not be reused across
                    different projects or document types. They are always three characters long. The allowed format is determined by the main category.</p>
                <ul class="space-y-1.5 pl-1">
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Signed projects</strong>: numerical, equal to the serial number in three-digit
                            format. Can only be assigned by the COO.</span>
                    </li>
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Studies</strong>: three-letter sequential alphabetic code (AAA-ZZZ). Next available code is automatically assigned by filling in any of the available forms on SharePoint (e.g. <a href="https://valuemaritime.sharepoint.com/sites/Engineering_new/SalesDocs/Lists/Feasibility%20Request/AllItems.aspx" class="text-primary dark:text-cyan-500 underline underline-offset-2" target="_blank">Maritime Feasibility Study Request</a>).</span>
                    </li>
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Product lines</strong>: fixed abbreviation maintained by the Product Owners.
                            Publishing related documents requires consultation with a Product Owner.</span>
                    </li>
                </ul>

                <div
                    class="flex gap-2 bg-emerald-50 dark:bg-emerald-950 px-3 py-2 border border-emerald-200 dark:border-emerald-800 rounded text-emerald-800 dark:text-emerald-200">
                    <span class="font-bold text-emerald-600 shrink-0">✓</span>The Ledger incorporates the correct
                    reference code format per main category.
                </div>

            </div>

            <twig:Separator />

            <div class="space-y-2">
                <h3 class="font-semibold text-foreground">Revision</h3>
                <ul class="space-y-2.5 pl-1">
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Interim</strong>: alphanumeric suffix starting at <twig:CodeChip size="inline">0A</twig:CodeChip>,
                            incrementing the letter for each subsequent draft.</span>
                    </li>
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Released</strong>: numeric suffix starting at <twig:CodeChip size="inline">00</twig:CodeChip>,
                            incrementing for each subsequent formal reissue.</span>
                    </li>
                </ul>

                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                    <span class="mr-1 text-muted-foreground">Example sequence:</span>
                    {% for rev in ['0A', '0B', '0C', '00', '1A', '01'] %}
                    {% if not loop.first %}<span class="font-bold text-muted-foreground">→</span>{% endif %}
                    <twig:CodeChip variant="{{ rev matches '/^\\d+$/' ? 'success' : 'muted' }}">{{ rev }}</twig:CodeChip>
                    {% endfor %}
                </div>

                <div
                    class="flex gap-2 bg-amber-50 dark:bg-amber-950 px-3 py-2 border border-amber-200 dark:border-amber-800 rounded text-amber-800 dark:text-amber-200">
                    <twig:ux:icon name="material-symbols:warning-outline" class="mt-0.5 size-4 shrink-0" />
                    <p>Don't use a released format (00) for a document still under internal review.
                    </p>
                </div>
            </div>

            <twig:Separator />

            <div class="space-y-2">
                <h3 class="font-semibold text-foreground">Titles</h3>
                <ul class="space-y-2.5 pl-1">
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Language</strong>: titles are always written in <strong>British English</strong>,
                            e.g. <twig:CodeChip size="inline">Organisation</twig:CodeChip> rather than <twig:CodeChip size="inline">Organization</twig:CodeChip>.</span>
                    </li>
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Character set</strong>: only alphanumeric characters (A-Z, a-z, 0-9) and spaces
                            are allowed, with a maximum length of <strong>48 characters</strong> including
                            spaces.</span>
                    </li>
                    <li class="flex flex-col gap-1.5">
                        <div class="flex gap-2">
                            <span class="text-muted-foreground shrink-0">→</span>
                            <span><strong>Separator</strong>: the 22-character document code is <strong>always</strong>
                                followed by a single space and then the title. Do <strong>not</strong> separate the
                                code from the title using a hyphen or any other character.</span>
                        </div>
                        <div class="flex items-center gap-1.5 pl-5 text-xs">
                            <twig:CodeChip>VG0-AAB-REP-000-000-0A</twig:CodeChip>
                            <span
                                class="inline-flex items-center gap-1 bg-emerald-100 dark:bg-emerald-900 px-1.5 py-1 border border-emerald-200 dark:border-emerald-800 rounded font-sans text-emerald-700 dark:text-emerald-300">
                                <twig:ux:icon name="material-symbols:space-bar" class="size-3.5" />
                                space
                            </span>
                            <twig:CodeChip>Title</twig:CodeChip>
                        </div>
                    </li>
                    <li class="flex gap-2">
                        <span class="text-muted-foreground shrink-0">→</span>
                        <span><strong>Casing</strong>: the title utilises <twig:CodeChip size="inline">Title Case</twig:CodeChip>.
                            Each word should start with a capital letter, except for certain short words (like "and",
                            "or", "the") unless they are the first or last word of the title. Abbreviations can be fully capitalised, e.g. <twig:CodeChip size="inline">pid → PID</twig:CodeChip>.</span>
                    </li>
                </ul>

                <div
                    class="flex gap-2 bg-emerald-50 dark:bg-emerald-950 px-3 py-2 border border-emerald-200 dark:border-emerald-800 rounded text-emerald-800 dark:text-emerald-200">
                    <span class="font-bold text-emerald-600 shrink-0">✓</span>The Ledger has built-in sanitisation and
                    character limit.
                </div>
            </div>

        </twig:Card:Content>
    </twig:Card>

    {# ── Examples ─────────────────────────────────────────────────────── #}
    <twig:Card id="examples" class="xl:col-span-2 scroll-mt-4">
        <twig:Card:Header>
            <twig:Card:Title>Examples</twig:Card:Title>
            <twig:Card:Description>Correct and incorrect identifiers</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content class="space-y-5 text-sm">

            <div class="space-y-2">
                <p class="font-semibold text-emerald-700 dark:text-emerald-400">Correct</p>
                <ul class="space-y-2">
                    {% for id in ['VM1-AAB-REP-100-001-0A Site Survey', 'VC5-045-DWG-320-003-01 Piping Layout'] %}
                    <li class="flex items-center gap-2">
                        <span class="font-bold text-emerald-600 shrink-0">✓</span>
                        <twig:CodeChip variant="success">{{ id }}</twig:CodeChip>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <twig:Separator />

            <div class="space-y-2">
                <p class="font-semibold text-destructive">Incorrect</p>
                <ul class="space-y-2">
                    {% for id, reason in {
                        'VM1–AAB–REP–100–001–0A Site Survey': 'en dash used instead of hyphen-minus',
                        'VM1-AAB-REP-100-001-0A-Site Survey': 'hyphen used between code and title instead of a space',
                        'vm1-aab-rep-100-001-0a Site Survey': 'code must be fully capitalised',
                        'VM1-AB-REP-100-001-0A Site Survey': 'reference code for a study must be three letters',
                        'VM1-AAB-REP-100-001-0A P&ID System': 'title contains characters other than letters, digits and spaces',
                    } %}
                    <li class="flex items-center gap-2">
                        <span class="font-bold text-destructive shrink-0">✗</span>
                        <twig:CodeChip variant="danger">{{ id }}</twig:CodeChip>
                        <span class="text-muted-foreground">{{ reason }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </div>

        </twig:Card:Content>
    </twig:Card>


    {# ── Do's and Don'ts ─────────────────────────────────────────────────────── #}
    <twig:Card id="dos-and-donts" class="scroll-mt-4">
        <twig:Card:Header>
            <twig:Card:Title>Do's and Don'ts</twig:Card:Title>
            <twig:Card:Description>Short recap</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Content class="text-sm">
            <div class="gap-6 grid grid-cols-1 sm:grid-cols-2">

                <div class="space-y-2.5">
                    <p class="font-semibold text-emerald-700 dark:text-emerald-400">Do</p>
                    <ul class="space-y-2.5">
                        <li class="flex gap-2">
                            <span class="font-bold text-emerald-600 shrink-0">✓</span>
                            Check the ledger for an available number before creating a new document.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-emerald-600 shrink-0">✓</span>
                            Start with an interim revision (0A) and promote to a final release (00) only when the
                            document is formally approved and issued.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-emerald-600 shrink-0">✓</span>
                            Write a concise but descriptive title. It aids discoverability and understanding.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-emerald-600 shrink-0">✓</span>
                            Use the correct main category and reference code format for the project type.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-emerald-600 shrink-0">✓</span>
                            Register every document identifier, internal and external, in the ledger before distributing
                            it.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-emerald-600 shrink-0">✓</span>
                            Add keywords to ledger entries to improve searchability.
                        </li>
                    </ul>
                </div>

                <div class="space-y-2.5">
                    <p class="font-semibold text-destructive">Don't</p>
                    <ul class="space-y-2.5">
                        <li class="flex gap-2">
                            <span class="font-bold text-destructive shrink-0">✗</span>
                            Don't reuse an existing identifier for a different document.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-destructive shrink-0">✗</span>
                            Don't skip revision steps. Every issued version must be recorded, even if superseded
                            quickly.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-destructive shrink-0">✗</span>
                            Don't create document identifiers outside of Value Ledger. Even for one-offs.
                        </li>
                        <li class="flex gap-2">
                            <span class="font-bold text-destructive shrink-0">✗</span>
                            Don't use a hyphen between the document ID and the title.
                        </li>
                    </ul>
                </div>

            </div>
        </twig:Card:Content>
    </twig:Card>

    {# ── Ledger ─────────────────────────────────────────────────────── #}
    <twig:Card id="using-the-ledger" class="scroll-mt-4">
        <twig:Card:Header>
            <twig:Card:Title>Using the Ledger</twig:Card:Title>
        </twig:Card:Header>
        <twig:Card:Content class="space-y-6 text-sm">
            <div class="space-y-4">
                <div>
                    <h3 class="mb-2 font-semibold text-foreground">How to add entries</h3>
                    <p class="">Click the <strong>"New Entry"</strong> button to create a new document identifier. Fill
                        in each required field: subsidiary code, main category, reference code, document type, sub
                        category, and title. Also fill in search keywords to improve searchability for other
                        users. The system will automatically format and store the document ID. Once saved, the entry
                        appears in
                        the ledger and can be viewed by all.</p>
                </div>

                <div>
                    <h3 class="mb-2 font-semibold text-foreground">How to edit entries</h3>
                    <p class="">Locate the entry in the ledger and click the
                        <twig:ux:icon name="material-symbols:edit-outline" class="inline" /> (edit) button. You can
                        update the title and other metadata. Always review changes before saving to ensure compliance
                        with the naming conventions.
                    </p>
                </div>

                <div>
                    <h3 class="mb-2 font-semibold text-foreground">How to search</h3>
                    <p class="">Use the search bar at the top of the ledger page to filter entries by document ID
                        components, title, or keywords. Search is case-insensitive and supports partial matches. You can
                        also use filters.</p>
                </div>

                <div>
                    <h3 class="mb-2 font-semibold text-foreground">User vs admin rights</h3>
                    <p class=""><strong>Users</strong> can only view entries. <strong>Admins</strong> can create, edit,
                        and delete entries.</p>
                </div>

                <div>
                    <h3 class="mb-2 font-semibold text-foreground">Tips and tricks</h3>
                    <ul class="space-y-1 list-disc list-inside">
                        <li>You can sort the table by clicking on the column headers.</li>
                        <li>You can easily copy the document ID by clicking on it!</li>
                        <li>You can export entries as an XLSX file for easy sharing and analysis.</li>
                    </ul>
                </div>
            </div>
        </twig:Card:Content>
    </twig:Card>



</div>

{% endblock %}
